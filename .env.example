# ─── App ──────────────────────────────────────────────────────────────────────
VITE_APP_URL=https://react-app-starter.com
VITE_APP_NAME=React App Starter

# ─── API ──────────────────────────────────────────────────────────────────────
# Dev: used by Vite proxy (/api/* → this URL)
VITE_API_URL=https://jsonplaceholder.typicode.com
# Prod: direct API base URL (no proxy in production)
VITE_API_URL_PROD=https://api.your-domain.com

# ─── WebSocket ────────────────────────────────────────────────────────────────
VITE_WEBSOCKET_DEV=ws://localhost:8080
VITE_WEBSOCKET_PROD=wss://ws.your-domain.com
